cabal-version: 3.0
name:          sc-testing-tools-tutorial
version:       0.1.0.0
synopsis:      Tutorial for getting started with sc-testing-tools
license:       Apache-2.0
license-files: LICENSE
build-type:    Simple

common lang
  default-language:   Haskell2010
  default-extensions:
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveLift
    DeriveTraversable
    ExplicitForAll
    FlexibleContexts
    GeneralizedNewtypeDeriving
    ImportQualifiedPost
    MultiParamTypeClasses
    NumericUnderscores
    OverloadedStrings
    ScopedTypeVariables
    StandaloneDeriving
    TemplateHaskell
    TypeFamilies

  ghc-options:
    -Wall -Wnoncanonical-monad-instances -Wunused-packages
    -Wincomplete-uni-patterns -Wincomplete-record-updates
    -Wredundant-constraints -Widentities

library
  import:          lang
  hs-source-dirs:  src
  exposed-modules:
    Auction.Contract
    PingPong.Contract

  build-depends:
    , base                     >=4.14 && <5
    , cardano-api
    , cardano-ledger-shelley
    , containers
    , convex-base
    , convex-mockchain
    , plutus-ledger-api
    , plutus-tx
    , plutus-tx-plugin

test-suite tutorial-pingpong-test
  import:         lang
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        PingPong/Spec.hs
  other-modules:  PingPong.TestingInterface
  build-depends:
    , aeson
    , base                     >=4.14 && <5
    , convex-tasty-streaming
    , convex-testing-interface
    , sc-testing-tools-tutorial
    , tasty
    , tasty-hunit

test-suite tutorial-auction-test
  import:         lang
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Auction/Spec.hs
  build-depends:
    , aeson
    , base                     >=4.14 && <5
    , convex-tasty-streaming
    , convex-testing-interface
    , plutus-tx
    , sc-testing-tools-tutorial
    , tasty
    , tasty-hunit

